{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.shellfu/sinter",
  "title": "Sinter",
  "description": "Persistent, evidence-backed code graph for coding agents.",
  "websiteUrl": "https://getsinter.io",
  "repository": {
    "url": "https://github.com/shellfu/sinter",
    "source": "github"
  },
  "version": "0.54.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sinter-io",
      "version": "0.54.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "sinter-io"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "sinter"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--repo",
          "value": "."
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
