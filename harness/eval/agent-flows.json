{
  "schema": 1,
  "fixture": {
    "base": "fixtures/agent-flow/base",
    "committed_overlay": "fixtures/agent-flow/committed-overlay"
  },
  "cases": [
    {
      "id": "orient-before-navigation",
      "capability": "orientation",
      "steps": [
        {
          "kind": "cli",
          "id": "map",
          "args": ["map"],
          "expect": [
            {"pointer": "/orientation/kind", "predicate": "equals", "value": "repository_inventory"},
            {"pointer": "/orientation/hub_metric", "predicate": "equals", "value": "non_contains_in_degree"},
            {"pointer": "/modules", "predicate": "contains", "value": {"path": "src", "files": 1}},
            {"pointer": "/hubs", "predicate": "contains", "value": {"name": "dispatch", "file": "src/lib.rs"}},
            {"pointer": "/docs", "predicate": "contains", "value": {"file": "README.md"}},
            {"pointer": "/docs/0/sections", "predicate": "contains", "value": "Agent flow fixture"},
            {"pointer": "/health/status", "predicate": "equals", "value": "partial"},
            {"pointer": "/health/compiler_index/state", "predicate": "equals", "value": "missing"}
          ]
        },
        {
          "kind": "cli",
          "id": "ask-entry",
          "args": ["ask", "public entry point for the request flow", "--limit", "5", "--explain"],
          "expect": [
            {"pointer": "/topics/0/hits", "predicate": "contains", "value": {"qualified": "entry"}},
            {"pointer": "/topics/0/verify_required", "predicate": "exists"},
            {"pointer": "/topics/0/confidence/calibration/version", "predicate": "equals", "value": "ask-holdout-2026-08-23.v2"}
          ]
        }
      ]
    },
    {
      "id": "forward-dependencies-before-edit",
      "capability": "dependency_analysis",
      "steps": [
        {
          "kind": "cli",
          "id": "deps-entry",
          "args": ["deps", "entry", "--relations", "calls,uses"],
          "expect": [
            {"pointer": "/dependencies", "predicate": "contains", "value": {"s": "dispatch"}}
          ]
        },
        {
          "kind": "cli",
          "id": "show-dispatch",
          "args": ["show", "dispatch"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "dispatch"},
            {"pointer": "/outgoing", "predicate": "non_empty"}
          ]
        }
      ]
    },
    {
      "id": "reverse-blast-radius-before-edit",
      "capability": "blast_radius",
      "steps": [
        {
          "kind": "cli",
          "id": "affected-leaf",
          "args": ["affected", "leaf", "--relations", "calls,uses"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "dispatch"}},
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "entry"}}
          ]
        },
        {
          "kind": "cli",
          "id": "path-entry-leaf",
          "args": ["path", "entry", "leaf", "--relations", "calls,uses"],
          "expect": [
            {"pointer": "/found", "predicate": "equals", "value": true},
            {"pointer": "/steps", "predicate": "non_empty"}
          ]
        }
      ]
    },
    {
      "id": "select-tests-from-callers",
      "capability": "test_selection",
      "steps": [
        {
          "kind": "cli",
          "id": "affected-dispatch",
          "args": ["affected", "dispatch", "--depth", "1", "--relations", "calls"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "tests::dispatch_works"}}
          ]
        },
        {
          "kind": "cli",
          "id": "show-test",
          "args": ["show", "tests::dispatch_works"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "dispatch_works"}
          ]
        }
      ]
    },
    {
      "id": "abstain-on-ambiguous-symbol",
      "capability": "unresolved_ambiguity",
      "steps": [
        {
          "kind": "cli",
          "id": "ambiguous-show",
          "args": ["show", "duplicate"],
          "expected_exit": 2,
          "decision": "abstain",
          "expect": [
            {"pointer": "/error/code", "predicate": "equals", "value": "ambiguous_symbol"},
            {"pointer": "/error/candidates", "predicate": "non_empty"}
          ]
        },
        {
          "kind": "cli",
          "id": "inspect-unresolved",
          "args": ["unresolved", "--limit", "20"],
          "expect": [
            {"pointer": "/unresolved", "predicate": "non_empty"}
          ]
        }
      ]
    },
    {
      "id": "impact-drives-test-selection",
      "capability": "diff_impact",
      "steps": [
        {
          "kind": "cli",
          "id": "impact",
          "args": ["impact", "HEAD~1..HEAD"],
          "expect": [
            {"pointer": "/changed_files", "predicate": "contains", "value": {"path": "src/lib.rs"}},
            {"pointer": "/changed_symbols", "predicate": "non_empty"},
            {"pointer": "/affected_tests", "predicate": "contains", "value": {"qualified": "tests::dispatch_works"}}
          ]
        },
        {
          "kind": "cli",
          "id": "impact-callers",
          "args": ["affected", "leaf", "--relations", "calls"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "tests::dispatch_works"}}
          ]
        }
      ]
    },
    {
      "id": "reuse-handle-after-harmless-shift",
      "capability": "stable_handle_reuse",
      "steps": [
        {
          "kind": "cli",
          "id": "find-leaf",
          "args": ["query", "leaf", "--limit", "1"],
          "expect": [
            {"pointer": "/results/0/name", "predicate": "equals", "value": "leaf"}
          ],
          "capture": [
            {"name": "leaf_handle", "pointer": "/results/0/id"}
          ]
        },
        {
          "kind": "edit",
          "id": "shift-offsets",
          "path": "src/lib.rs",
          "operation": "prepend",
          "value": "// harmless line inserted by the agent-flow evaluation\n"
        },
        {
          "kind": "cli",
          "id": "reuse-leaf-handle",
          "args": ["show", "${leaf_handle}"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "leaf"}
          ]
        }
      ]
    },
    {
      "id": "dirty-edit-refresh-and-coverage",
      "capability": "dirty_edit",
      "steps": [
        {
          "kind": "edit",
          "id": "add-dirty-symbol",
          "path": "src/lib.rs",
          "operation": "append",
          "value": "\n/// Added only in the working tree.\npub fn dirty_symbol() -> usize { entry() }\n"
        },
        {
          "kind": "cli",
          "id": "find-dirty-symbol",
          "args": ["query", "dirty_symbol", "--limit", "5"],
          "expect": [
            {"pointer": "/results", "predicate": "contains", "value": {"name": "dirty_symbol"}}
          ]
        },
        {
          "kind": "cli",
          "id": "dirty-negative-path",
          "args": ["path", "entry", "external_reference", "--relations", "calls,uses"],
          "expected_exit": 1,
          "expect": [
            {"pointer": "/found", "predicate": "equals", "value": false},
            {"pointer": "/coverage/status", "predicate": "equals", "value": "not_proven"},
            {"pointer": "/coverage/snapshot/dirty", "predicate": "equals", "value": true}
          ]
        }
      ]
    },
    {
      "id": "mcp-cli-query-parity",
      "capability": "mcp_cli_parity",
      "steps": [
        {
          "kind": "cli",
          "id": "cli-query",
          "args": ["query", "leaf", "--limit", "5"],
          "expect": [
            {"pointer": "/results", "predicate": "contains", "value": {"name": "leaf"}}
          ]
        },
        {
          "kind": "mcp",
          "id": "mcp-query",
          "tool": "query",
          "arguments": {"symbol": "leaf", "limit": 5},
          "expect": [
            {"pointer": "/protocol", "predicate": "equals", "value": "sinter.agent.v1"},
            {"pointer": "/data/results", "predicate": "contains", "value": {"name": "leaf"}}
          ]
        },
        {
          "kind": "compare",
          "id": "same-query-data",
          "left": {"step": "cli-query", "pointer": ""},
          "right": {"step": "mcp-query", "pointer": "/data"}
        }
      ]
    },
    {
      "id": "bounded-content-search",
      "capability": "bounded_content_search",
      "steps": [
        {
          "kind": "cli",
          "id": "grep-within-affected",
          "args": ["grep", "dispatch\\(\\)", "--within", "affected(leaf)"],
          "expect": [
            {"pointer": "/status", "predicate": "equals", "value": "found"},
            {"pointer": "/within", "predicate": "contains", "value": "affected(leaf)"},
            {"pointer": "/files_in_bound", "predicate": "equals", "value": 1},
            {"pointer": "/matches", "predicate": "contains", "value": {"f": "src/lib.rs", "t": "    dispatch()"}}
          ]
        },
        {
          "kind": "cli",
          "id": "grep-within-deps",
          "args": ["grep", "unavailable_dependency", "--within", "deps(entry)"],
          "expect": [
            {"pointer": "/within", "predicate": "contains", "value": "deps(entry)"},
            {"pointer": "/matches", "predicate": "non_empty"},
            {"pointer": "/files_searched", "predicate": "exists"}
          ]
        }
      ]
    },
    {
      "id": "bounded-content-search-old-way",
      "capability": "bounded_content_search",
      "steps": [
        {
          "kind": "cli",
          "id": "affected-leaf",
          "args": ["affected", "leaf", "--relations", "calls"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "dispatch"}}
          ]
        },
        {
          "kind": "cli",
          "id": "show-dispatch",
          "args": ["show", "dispatch"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "dispatch"}
          ]
        },
        {
          "kind": "cli",
          "id": "show-entry",
          "args": ["show", "entry"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "entry"}
          ]
        },
        {
          "kind": "cli",
          "id": "show-test",
          "args": ["show", "tests::dispatch_works"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "dispatch_works"}
          ]
        }
      ]
    },
    {
      "id": "refactor-completeness",
      "capability": "refactor_completeness",
      "steps": [
        {
          "kind": "cli",
          "id": "impact-expect-leaf",
          "args": ["impact", "HEAD~1..HEAD", "--expect", "leaf"],
          "expect": [
            {"pointer": "/changed_symbols", "predicate": "contains", "value": {"qualified": "leaf"}},
            {"pointer": "/expect", "predicate": "contains", "value": {"symbol": "leaf", "untouched_total": 1}},
            {"pointer": "/expect/0/untouched", "predicate": "contains", "value": {"qualified": "dispatch"}}
          ]
        },
        {
          "kind": "cli",
          "id": "impact-expect-two-symbols",
          "args": ["impact", "HEAD~1..HEAD", "--expect", "leaf", "--expect", "dispatch"],
          "expect": [
            {"pointer": "/expect", "predicate": "contains", "value": {"symbol": "dispatch"}},
            {"pointer": "/expect/1/untouched", "predicate": "contains", "value": {"qualified": "entry"}},
            {"pointer": "/expect/1/untouched", "predicate": "contains", "value": {"qualified": "tests::dispatch_works"}}
          ]
        }
      ]
    },
    {
      "id": "refactor-completeness-old-way",
      "capability": "refactor_completeness",
      "steps": [
        {
          "kind": "cli",
          "id": "impact-range",
          "args": ["impact", "HEAD~1..HEAD"],
          "expect": [
            {"pointer": "/changed_symbols", "predicate": "contains", "value": {"qualified": "leaf"}}
          ]
        },
        {
          "kind": "cli",
          "id": "direct-dependents-of-changed",
          "args": ["affected", "leaf", "--depth", "1", "--relations", "calls"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "dispatch"}}
          ]
        },
        {
          "kind": "cli",
          "id": "show-untouched-dependent",
          "args": ["show", "dispatch"],
          "expect": [
            {"pointer": "/symbol/file", "predicate": "equals", "value": "src/lib.rs"}
          ]
        }
      ]
    },
    {
      "id": "symbol-body-without-file-read",
      "capability": "symbol_body",
      "steps": [
        {
          "kind": "cli",
          "id": "show-body-dispatch",
          "args": ["show", "dispatch", "--body"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "dispatch"},
            {"pointer": "/excerpt", "predicate": "contains", "value": "leaf()"},
            {"pointer": "/outgoing", "predicate": "non_empty"}
          ]
        },
        {
          "kind": "cli",
          "id": "show-body-leaf-bounded",
          "args": ["show", "leaf", "--body", "--context-lines", "3"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "leaf"},
            {"pointer": "/excerpt", "predicate": "contains", "value": "pub fn leaf"}
          ]
        }
      ]
    },
    {
      "id": "multi-seed-blast-radius",
      "capability": "multi_seed_blast_radius",
      "steps": [
        {
          "kind": "cli",
          "id": "affected-two-seeds",
          "args": ["affected", "leaf", "dispatch", "--relations", "calls"],
          "expect": [
            {"pointer": "/symbols", "predicate": "contains", "value": {"name": "leaf"}},
            {"pointer": "/symbols", "predicate": "contains", "value": {"name": "dispatch"}},
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "entry", "seeds": "dispatch"}},
            {"pointer": "/total", "predicate": "equals", "value": 3}
          ]
        },
        {
          "kind": "cli",
          "id": "affected-three-seeds",
          "args": ["affected", "leaf", "dispatch", "entry", "--relations", "calls"],
          "expect": [
            {"pointer": "/symbols", "predicate": "contains", "value": {"name": "entry"}},
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "tests::dispatch_works"}}
          ]
        }
      ]
    },
    {
      "id": "multi-seed-blast-radius-old-way",
      "capability": "multi_seed_blast_radius",
      "steps": [
        {
          "kind": "cli",
          "id": "affected-seed-leaf",
          "args": ["affected", "leaf", "--relations", "calls"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "dispatch"}}
          ]
        },
        {
          "kind": "cli",
          "id": "affected-seed-dispatch",
          "args": ["affected", "dispatch", "--relations", "calls"],
          "expect": [
            {"pointer": "/dependents", "predicate": "contains", "value": {"s": "entry"}}
          ]
        },
        {
          "kind": "cli",
          "id": "affected-seed-entry",
          "args": ["affected", "entry", "--relations", "calls"],
          "expected_exit": 1,
          "expect": [
            {"pointer": "/status", "predicate": "equals", "value": "not_proven"},
            {"pointer": "/total", "predicate": "equals", "value": 0}
          ]
        }
      ]
    },
    {
      "id": "context-seeds-from-task-identifiers",
      "capability": "task_context",
      "steps": [
        {
          "kind": "cli",
          "id": "context-named-symbols",
          "args": ["context", "change dispatch so leaf returns a different value"],
          "expect": [
            {"pointer": "/anchors", "predicate": "contains", "value": {"qualified": "dispatch", "term": "dispatch"}},
            {"pointer": "/anchors", "predicate": "contains", "value": {"qualified": "leaf", "term": "leaf"}},
            {"pointer": "/candidates/0/qualified", "predicate": "equals", "value": "dispatch"},
            {"pointer": "/candidates/0/why/channels", "predicate": "contains", "value": "identifier"},
            {"pointer": "/tests", "predicate": "contains", "value": {"qualified": "tests::dispatch_works"}}
          ]
        },
        {
          "kind": "cli",
          "id": "context-unknown-identifier",
          "args": ["context", "rename nonexistent_symbol_xyz across the crate"],
          "expected_exit": 1,
          "expect": [
            {"pointer": "/outcome", "predicate": "equals", "value": "abstain"},
            {"pointer": "/gaps/abstain_reason", "predicate": "equals", "value": "no_match"},
            {"pointer": "/candidates", "predicate": "equals", "value": []}
          ]
        }
      ]
    },
    {
      "id": "design-similarity-before-naming",
      "capability": "design_similarity",
      "steps": [
        {
          "kind": "cli",
          "id": "ask-role-scope-shape",
          "args": ["ask", "role to authorization scope mapping table", "--limit", "10"],
          "expect": [
            {"pointer": "/topics/0/hits", "predicate": "contains", "value": {"qualified": "endpoint_role_scope_table"}},
            {"pointer": "/topics/0/hits", "predicate": "contains", "value": {"qualified": "delegated_role_scope_table"}}
          ]
        },
        {
          "kind": "cli",
          "id": "verify-existing-table",
          "args": ["show", "delegated_role_scope_table", "--body"],
          "expect": [
            {"pointer": "/symbol/name", "predicate": "equals", "value": "delegated_role_scope_table"},
            {"pointer": "/excerpt", "predicate": "contains", "value": "endpoint:delegate"}
          ]
        }
      ]
    }
  ]
}
